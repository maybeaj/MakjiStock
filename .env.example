# Naver Developers (기존 애플리케이션은 2027-06-30까지 지원 예정)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 또는 NAVER API HUB
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 한국은행 ECOS 원/달러 일별 종가 API
BOK_ECOS_API_KEY=

# Supabase (비어 있으면 로컬 메모리 데모 모드)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 익명 방문자와 이메일 보호
# 익명 방문자 토큰 해시 키 (서버 전용) — openssl rand -hex 32
VISITOR_TOKEN_HMAC_SECRET=
EMAIL_ENCRYPTION_KEY=

# 내부 작업 보호
CRON_SECRET=change-me-in-production

# Cafe24 Admin API: 브라우저에 노출하지 말 것
# 구매 버튼이 어디로 갈지
#   demo (기본) rabbit3456 데모몰 — 가격 PUT 을 시험하는 곳
#   live        makji.kr 자사몰 — 손님이 실제로 사는 곳 (products.shop_url)
SHOP_TARGET=demo

# 현재 가격 반영 테스트몰. 실제 막지몰로 전환할 때 해당 mall_id로 교체한다.
CAFE24_MALL_ID=rabbit3456
CAFE24_SHOP_NO=1

# access_token / refresh_token 은 여기 넣지 않는다.
#   access_token 은 2시간, refresh_token 은 갱신할 때마다 바뀐다.
#   환경변수에 박으면 몇 시간 만에 죽고, Vercel 은 재배포해야 반영된다.
#   토큰은 Supabase cafe24_tokens 에 암호화해 두고 서버가 스스로 갱신한다.
#   확인: node scripts/cafe24-token.mjs
#
# 상품번호도 넣지 않는다. Supabase products.cafe24_product_no 에 있고
#   POST /api/internal/sync-products 로 몰에서 동기화한다.

# 메일 공급자 (비어 있으면 발송 로그만 기록하는 데모 모드)
MAIL_API_KEY=
MAIL_FROM=

# Cafe24 개발자센터에서 앱 등록 시 발급
# 저장 토큰 암호화 키 — openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# 배포 주소. 비우면 VERCEL_PROJECT_PRODUCTION_URL, 그것도 없으면 localhost:3000
CAFE24_REDIRECT_BASE_URL=https://makji-stock.vercel.app

# 개발 모드 전용: 서버의 오늘(KST)을 덮어쓴다. 예) DEV_KST_DATE=2026-09-17, DEV_KST_HOUR=10
# DEV_KST_DATE=
# DEV_KST_HOUR=
