{
  "name": "makji-stock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:pricing && npm run test:backtest && npm run typecheck && npm run lint",
    "test:pricing": "node --test tests/*.test.mjs",
    "test:backtest": "node --test backtest/test/*.test.mjs",
    "backtest": "node backtest/run.mjs",
    "probe:inputs": "node scripts/price-input-probe.mjs",
    "simulate:pricing": "node scripts/simulate-pricing.mjs",
    "db:setup-sql": "node scripts/build-setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  }
}
